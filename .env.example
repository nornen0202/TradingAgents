# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# Default investment provider/model: Codex gpt-6.1-sol (codex login; no API key required).
# Use a CLI that lists gpt-6.1-sol; verified with official @openai/codex 0.161.0.
# Optional full native executable path, also used by scheduled processes.
# CODEX_BINARY=C:/full/path/to/codex.exe
# Exact requested model is required; older/smaller fallbacks are opt-in.
TRADINGAGENTS_CODEX_ALLOW_MODEL_FALLBACK=0
TRADINGAGENTS_CODEX_PREFLIGHT_ALLOW_MODEL_FALLBACK=0

# Optional historical-vintage macro evidence (missing key is reported as unavailable).
FRED_API_KEY=

# Optional output cap for API providers; Codex uses request timeout/retry limits.
# TRADINGAGENTS_MAX_TOKENS=16384
